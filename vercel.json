{
    "version": 2,
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/p/(.*)",
            "dest": "/api/p/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}