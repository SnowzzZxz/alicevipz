{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/admin",
            "dest": "/admin.html"
        },
        {
            "src": "/admin.html",
            "dest": "/admin.html"
        },
        {
            "src": "/p/(.*)",
            "dest": "/api/p/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
